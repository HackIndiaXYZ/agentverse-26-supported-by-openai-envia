{
  "name": "envia",
  "version": "0.1.0",
  "description": "Envia: jail-themed container platform and MCP server for building images, running bounded workloads, managing volumes, and executing AI-agent experiments with audit ledgers, candidate diffs, approval gates, and transactional application.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "envia": "dist/cli/main.js",
    "envia-mcp": "dist/mcp/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "commands",
    ".claude-plugin",
    ".mcp.json",
    ".env.example"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HackIndiaXYZ/agentverse-26-supported-by-openai-envia.git"
  },
  "homepage": "https://github.com/HackIndiaXYZ/agentverse-26-supported-by-openai-envia",
  "bugs": {
    "url": "https://github.com/HackIndiaXYZ/agentverse-26-supported-by-openai-envia/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/mcp/server.ts",
    "start": "node dist/mcp/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "ai-agents",
    "sandbox",
    "envia",
    "hackindia"
  ],
  "author": "dksh3",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^5.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.0"
  }
}
