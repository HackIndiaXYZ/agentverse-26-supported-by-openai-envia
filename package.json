{
  "name": "envia",
  "version": "0.1.0",
  "description": "Envia: hermetic, reproducible sandboxed environments for AI agent runs. MCP server + plugin.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "envia": "dist/cli/main.js",
    "envia-mcp": "dist/mcp/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/mcp/server.ts",
    "start": "node dist/mcp/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": ["mcp", "ai-agents", "sandbox", "envia", "hackindia"],
  "author": "dksh3",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.0"
  }
}
